# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables. Nunca versione o .env.

# --- Banco (obrigatório na Vercel): Turso / libSQL ---
# Sem estas variáveis, em desenvolvimento local usa o arquivo data/store.db
TURSO_DATABASE_URL=libsql://SEU-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=

# --- Uploads de imagens/vídeos (Vercel Blob; criado pela aba Storage da Vercel) ---
BLOB_READ_WRITE_TOKEN=

# --- Site ---
PUBLIC_URL=https://www.seudominio.com.br
# Administrador criado em `npm run db:setup` / `db:seed` (se omitido, a senha é gerada e exibida uma vez)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Pagamento (Mercado Pago). Sem token, em produção o checkout fica bloqueado ---
MP_ACCESS_TOKEN=
# ALLOW_MOCK_PAYMENTS=1   # só para demonstrar o fluxo em produção SEM cobrança real (não use em loja aberta)

# --- Local ---
PORT=3000

# --- WhatsApp Business Platform (Cloud API oficial da Meta) — pós-venda automático ---
# Só no servidor (Vercel → Environment Variables). NUNCA no frontend.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=escolha-um-texto-secreto
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_SUPPLIER_TEMPLATE=novo_pedido_fornecedor
WHATSAPP_TEMPLATE_LANG=pt_BR
# opcional: número do fornecedor (senão usa o cadastrado em Admin → Fornecedores)
WHATSAPP_SUPPLIER_NUMBER=

# --- E-mail ao cliente (rastreio) via Resend ---
RESEND_API_KEY=
MAIL_FROM="Sport Imperativo Store <pedidos@seudominio.com.br>"
