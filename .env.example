# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables. Nunca versione o .env.

# --- Banco (obrigatório na Vercel): Turso / libSQL ---
# Sem estas variáveis, em desenvolvimento local usa o arquivo data/store.db
TURSO_DATABASE_URL=libsql://SEU-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=

# --- Uploads de imagens/vídeos (Vercel Blob; criado pela aba Storage da Vercel) ---
BLOB_READ_WRITE_TOKEN=

# --- Site ---
PUBLIC_URL=https://www.seudominio.com.br
# Administrador criado em `npm run db:setup` / `db:seed` (se omitido, a senha é gerada e exibida uma vez)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Pagamento (Mercado Pago). Sem token, em produção o checkout fica bloqueado ---
MP_ACCESS_TOKEN=
# ALLOW_MOCK_PAYMENTS=1   # só para demonstrar o fluxo em produção SEM cobrança real (não use em loja aberta)

# --- Local ---
PORT=3000
