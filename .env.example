# Copie para .env (ou defina as variáveis no servidor). Nunca versione o .env.
PORT=3000
NODE_ENV=production
# URL pública (usada em sitemap, links de pagamento e webhooks)
PUBLIC_URL=https://www.seudominio.com.br
# Administrador criado na primeira inicialização (se omitido, a senha é gerada e exibida uma vez no console)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Gateway de pagamento (Mercado Pago). Sem token, a loja roda em MODO DE TESTE (pagamento simulado).
MP_ACCESS_TOKEN=
